# Base de datos (Neon Postgres)
DATABASE_URL=
# Solo para pruebas integrales; nunca usar la base de producción.
DATABASE_URL_TEST=

# Sesiones (JWT firmado a mano en lib/auth.ts)
JWT_SECRET=

# Login con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dominios de email permitidos para registro/login (separados por coma, con o sin @)
ALLOWED_EMAIL_DOMAINS=etec.um.edu.ar,um.edu.ar,alumno.etec.um.edu.ar

# Correo saliente (activación de cuentas). Sin SMTP_HOST, en desarrollo el correo
# se imprime en la consola del servidor; en producción el registro falla.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Copa ETec <no-reply@copaetec.online>"
# URL pública de esta API, usada en el link de activación (si falta, se toma del request)
API_URL=

# Usuario admin sembrado por scripts/migrate-prode.ts
ADMIN_EMAIL=admin@copaetec.online
ADMIN_PASSWORD=

# Subida de imágenes (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# URL pública del frontend (a donde redirige el login con Google, y origen permitido por CORS)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Zona horaria con la que el chatbot muestra los horarios de los partidos
TOURNAMENT_TIMEZONE=America/Argentina/Buenos_Aires
